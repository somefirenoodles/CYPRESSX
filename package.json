{
  "name": "cypressx",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicación web de pagos sandbox con Svelte y Oracle SQL.",
  "repository": {
    "type": "git",
    "url": "https://github.com/somefirenoodles/CYPRESSX.git"
  },
  "author": "Cypress.io contributors; adaptación académica Superpay",
  "license": "MIT",
  "engines": {
    "node": "22.20.x || 24.x"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch backend/server.ts",
    "start": "tsx backend/server.ts",
    "build": "vite build",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:migrate": "tsx backend/db/migrate.ts",
    "db:seed": "tsx backend/db/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "docs:generate": "node scripts/traceability.mjs generate",
    "docs:check": "node scripts/traceability.mjs check",
    "test:tooling": "node --test scripts/traceability.test.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=../reports/vitest.json",
    "evidence:start": "node scripts/evidence.mjs start",
    "evidence:finish": "node scripts/evidence.mjs finish",
    "ledger:check": "tsx backend/db/reconcile.ts",
    "test:oracle:isolated": "node scripts/validate-oracle.mjs",
    "test:migration:prepare": "tsx backend/db/prepare-upgrade-fixture.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "helmet": "8.1.0",
    "oracledb": "7.0.1",
    "svelte": "5.57.1",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/oracledb": "6.10.0",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.5",
    "cypress": "16.0.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
